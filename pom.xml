    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- release 优于 source/target：按目标 JDK 的 API 签名编译，防“编译过但运行时缺 API” -->
                        <release>${java.version}</release>
                        <!-- 关闭增量编译：构建更快，并规避 MCOMPILER-209 的增量编译误判 -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <!-- 一旦显式声明 annotationProcessorPaths，classpath 上的处理器就不再被自动发现。
                                 本框架在 starter 中声明了 @ConfigurationProperties，缺此条则不会生成
                                 spring-configuration-metadata.json（IDE 无法补全/校验配置键）。 -->
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <!-- 静态分析（P1，提炼自 mybatis-parent）：SpotBugs 已是 Default 档硬门禁（全仓 0 告警）；
                     modernizer 仍为 report-only——实测全仓 331 条违例（此前「0 违例」是 -q 抑制插件输出
                     导致的误判），待按规则聚类 triage 后再翻 failOnViolations=true -->
                <!-- 声明在 pluginManagement（而非只放在 format profile 内）：这样无 profile 时也能
                     按前缀调用（如 mvn formatter:validate 做 CI 校验），profile 只负责绑定执行 -->
                <plugin>
                    <groupId>net.revelc.code.formatter</groupId>
                    <artifactId>formatter-maven-plugin</artifactId>
                    <version>${formatter-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <!-- 排除镜像包与 E2E 支撑包，见仓库根 spotbugs-exclude.xml；
                             用多模块根目录定位，单模块单独构建时也能找到 -->
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                        <!-- 门禁拦 Default 档：全仓高优先级 10 条与中优先级 416 条均已处置——能改的
                             真修（防御性拷贝、只读包装、真实缺陷），设计使然的逐条核对后写进
                             exclude 文件并注明依据。临时放宽：mvn verify -Dspotbugs.threshold=High
                             踩坑记录一：写在 <execution> 的 <configuration> 里【不生效】（实测仍报 180 条），
                             必须放插件级（此处）。
                             踩坑记录二：值必须写成属性引用 ${spotbugs.threshold}，写死字面量时
                             命令行 -Dspotbugs.threshold=... 无法覆盖（pom 值优先） -->
                        <threshold>${spotbugs.threshold}</threshold>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.gaul</groupId>
                    <artifactId>modernizer-maven-plugin</artifactId>
                    <version>${modernizer-maven-plugin.version}</version>
                    <configuration>
                        <!-- 配置放插件级：CLI 直调 goal 也能拿到（execution 级配置对 CLI 直调不可见） -->
                        <javaVersion>17</javaVersion>
                        <!-- 仍只报告：全仓 331 条违例待按规则聚类 triage（翻 true 前必须先清零或逐条有据豁免） -->
                        <failOnViolations>false</failOnViolations>
                    </configuration>
                </plugin>
                <!-- 二进制兼容对比：compat profile 由 -Dcompat.oldVersion 显式激活（需仓库/本地
                     存在该版本的构件），避免无基线时误触发。用法：
                     mvn -Pcompat -Dcompat.oldVersion=3.5.6 verify -->
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                    <configuration>
                        <!-- 3.5.7 首次启用本门禁的一次性豁免（登记日期 2026-10-08）。
                             本门禁拿「同一 minor 系列的上一个 release tag」（此刻 = 3.5.6）当基线，而 3.5.6
                             发布时这些门禁并不存在（其 ci.yml 只有 build 一个 job，根 pom 无 japicmp/spotbugs/
                             formatter，scripts/ 亦无 check-docs.sh），故 3.5.6→3.5.7 期间**有意**累积的变更
                             全部落在「首次比对」里。下面逐条列出已核对为有意的项并注明依据（写法同 SpotBugs 的
                             exclude 惯例：能改的真修、设计使然的逐条写依据），使门禁自本次起重新生效 ——
                             本清单之外的**任何**新增不兼容都会让构建失败。
                             迁移说明见 docs/BREAKING-CHANGES.md（§二 配置键、§6.3 扩展点签名）。
                             japicmp 的 exclude 语法为 package.Class / package.Class#member；方法可附带
                             参数类型表（用于区分重载）。 -->
                        <parameter>
                            <excludes>
                                <!-- 配置键对齐：旧常量移除（键名迁移见 BREAKING-CHANGES §二） -->
                                <exclude>io.springperf.web.context.PropertiesConstant#ASYNC_TIMEOUT</exclude>
                                <exclude>io.springperf.web.context.PropertiesConstant#ASYNC_TIMEOUT_DEFAULT</exclude>
                                <exclude>io.springperf.web.context.PropertiesConstant#HTTP_MAX_HEADER_SIZE</exclude>
                                <exclude>io.springperf.web.context.PropertiesConstant#HTTP_MAX_HEADER_SIZE_DEFAULT</exclude>
                                <exclude>io.springperf.web.context.PropertiesConstant#SERVER_SHUTDOWN_TIMEOUT</exclude>
                                <exclude>io.springperf.web.context.PropertiesConstant#SERVER_SHUTDOWN_TIMEOUT_DEFAULT</exclude>
                                <exclude>io.springperf.web.context.PropertiesConstant#USE_FORWARDED_HEADERS</exclude>
                                <!-- 响应收尾与连接状态：签名变更 / 字段移除（BREAKING-CHANGES §6.3） -->
                                <exclude>io.springperf.web.core.DispatcherHandler#flushResponse(io.springperf.web.http.WebServerHttpResponse)</exclude>
                                <exclude>io.springperf.web.http.NettyServerHttpResponse#CONN_CTX</exclude>
                                <exclude>io.springperf.web.server.Http2ChannelInitializer#Http2ChannelInitializer(boolean, io.netty.handler.ssl.SslContext, int, long, boolean, io.springperf.web.server.NettyHttpHandler, java.util.List, java.util.List, int, int, int)</exclude>
                                <!-- 扩展点：接口新增方法（源码级不兼容，外部实现类需补实现；§6.3） -->
                                <exclude>io.springperf.web.http.WebServerHttpRequest#getURI()</exclude>
                                <exclude>io.springperf.web.http.WebServerHttpRequest#getRemoteAddress()</exclude>
                                <exclude>io.springperf.web.http.WebServerHttpRequest#getLocalAddress()</exclude>
                                <exclude>io.springperf.web.http.BaseWebServerHttpRequest#attributes</exclude>
                                <!-- Spring Boot 4 兼容层移除：master 收敛为纯 3.5.x（CHANGELOG 3.5.7「变更」） -->
                                <exclude>io.springperf.web.core.exception.ResponseStatusExceptionAdapter</exclude>
                                <exclude>io.springperf.web.util.MediaTypeUtils</exclude>
                                <exclude>io.springperf.web.core.retval.resolver.async.ListenableFutureAdapter</exclude>
                                <!-- 以下两条是 japicmp 在「新增类 × 被改动的接口」上的噪声：两者都是本轮新增的
                                     类（新增类不可能破坏既有用户），且它们实现的 WebMetrics 新增方法均带
                                     default（报告自身亦记作 Method new default）。 -->
                                <exclude>io.springperf.web.core.metrics.CountingWebMetrics</exclude>
                                <exclude>io.springperf.web.server.ErrorResponseConfig</exclude>
                            </excludes>
                        </parameter>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>1.6</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-maven-plugin</artifactId>
                    <version>${jmh.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <!-- 排除测试支撑模块（spring-web-test/support-test 的测试控制器与脚手架）：
                             它们不是生产代码，计入覆盖率只会稀释统计、且永远 0%（无单测执行） -->
                        <excludes>
                            <exclude>io/springperf/webtest/**</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 环境基线门禁（提炼自 mybatis-parent）：JDK / 依赖字节码 / Maven / 插件版本四类拦截。
                 2.7.x 分支的 maxJdkVersion 应为 8（其 java.version 不同），见
                 docs/feature/engineering-practices-checklist.md。requirePluginVersions 先限定
                 phases=clean,deploy,site，避免对默认生命周期插件误报。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>${extra-enforcer-rules.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <enforceBytecodeVersion>
                                    <maxJdkVersion>17</maxJdkVersion>
                                    <ignoredScopes>provided,test</ignoredScopes>
                                </enforceBytecodeVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                </requireMavenVersion>
                                <requirePluginVersions>
                                    <message>[ERROR] 插件版本必须显式声明：禁止 LATEST/RELEASE/SNAPSHOT 浮动版本</message>
                                    <banLatest>true</banLatest>
                                    <banRelease>true</banRelease>
                                    <banSnapshots>true</banSnapshots>
                                </requirePluginVersions>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 所有模块统一采集覆盖率（prepare-agent + report）。
                 此前只有部分模块声明，spring-web-support-test（全部 E2E 所在）从未挂 agent，
                 E2E 触发的服务端代码覆盖一直缺失，聚合报告严重低估真实覆盖率。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <!-- 静态分析挂在 verify（mybatis 清单的坑：只配 reporting = mvn site 才跑 = 形同虚设）。
                 现为硬门禁：spotbugs:check 按 Default 档阈值拦截，见 pluginManagement 注释。 -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotbugs-report</id>
                        <goals>
                            <!-- 报告（不失败）+ 供 CI 上传的 XML -->
                            <goal>spotbugs</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                    <execution>
                        <id>spotbugs-check</id>
                        <goals>
                            <!-- 硬门禁：发现 Default 档（高+中优先级）缺陷即失败（阈值/排除见 pluginManagement） -->
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.gaul</groupId>
                <artifactId>modernizer-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>modernizer-report</id>
                        <goals>
                            <goal>modernizer</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 二进制兼容对比（P1，提炼自 mybatis-parent）：显式给出上一发布版本才激活。
             用法：mvn -Pcompat -Dcompat.oldVersion=3.5.5 verify
             （基线构件需存在于本地仓库或远端仓库；pom 打包模块自动跳过） -->
        <profile>
            <id>compat</id>
            <activation>
                <property>
                    <name>compat.oldVersion</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>japicmp</id>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <!-- 层级要点（实测踩坑）：oldVersion / newVersion 是 <parameter> 的
                                         【兄弟节点】，<parameter> 本身对应 ConfigParameters（只放 onlyModified /
                                         skipPomModules 这类分析参数）。把 oldVersion 放进 <parameter> 里会报
                                         Cannot find 'oldVersion' in class japicmp.maven.ConfigParameters。 -->
                                    <oldVersion>
                                        <dependency>
                                            <groupId>${project.groupId}</groupId>
                                            <artifactId>${project.artifactId}</artifactId>
                                            <version>${compat.oldVersion}</version>
                                            <type>jar</type>
                                        </dependency>
                                    </oldVersion>
                                    <newVersion>
                                        <file>
                                            <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                        </file>
                                    </newVersion>
                                    <!-- 缺失时 japicmp 默认 false：检出二进制不兼容也照样 BUILD SUCCESS，
                                         门禁形同虚设——只产出一份没人看的报告。这是它唯一能真正拦截的开关。 -->
                                    <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                    <parameter>
                                        <skipPomModules>true</skipPomModules>
                                        <onlyModified>true</onlyModified>
                                    </parameter>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 格式化（P1，提炼自 mybatis-parent）：显式调用，绝不隐式运行。
             用法：./mvnw -Dformat=true process-sources
             首跑会重写几乎所有文件 → 必须独立成提交，不与功能提交混合。 -->
        <profile>
            <id>format</id>
            <activation>
                <property>
                    <name>format</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <!-- 同阶段按声明顺序执行：先删未用 import（rewrite），再统一排版（formatter），
                         pom 布局单独交给 sortpom。
                         不用 impsort：其给 JavaParser 配的语言级低于 14，无法解析本仓库的
                         instanceof 模式匹配等 Java 16+ 语法（探针实测：同一文件 JAVA_17 下
                         PARSE OK）；待上游修复后再引入。import 顺序目前由代码约定保证。 -->
                    <plugin>
                        <groupId>org.openrewrite.maven</groupId>
                        <artifactId>rewrite-maven-plugin</artifactId>
                        <version>${rewrite-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>remove-unused-imports</id>
                                <goals>
                                    <!-- 6.x 已移除专用 goal，统一走 run + activeRecipes -->
                                    <goal>run</goal>
                                </goals>
                                <phase>process-sources</phase>
                                <configuration>
                                    <activeRecipes>
                                        <recipe>org.openrewrite.java.RemoveUnusedImports</recipe>
                                    </activeRecipes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>net.revelc.code.formatter</groupId>
                        <artifactId>formatter-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>format-sources</id>
                                <goals>
                                    <goal>format</goal>
                                </goals>
                                <phase>process-sources</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.ekryd.sortpom</groupId>
                        <artifactId>sortpom-maven-plugin</artifactId>
                        <version>${sortpom-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sort-poms</id>
                                <goals>
                                    <goal>sort</goal>
                                </goals>
                                <phase>process-sources</phase>
                                <configuration>
                                    <nrOfIndentSpace>4</nrOfIndentSpace>
                                    <keepBlankLines>true</keepBlankLines>
                                    <!-- 不留 .bak：sortpom 默认会为每个 pom 生成备份文件，污染工作区 -->
                                    <createBackupFile>false</createBackupFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 文件基线（compat 的补充）：当上一版构件无法从仓库解析，或【本地仓库里恰好 install 过
             同版本号的自构建】时使用——后者会让 dependency 方式静默变成"自比对"，得出
             No incompatible changes 的假结论（实测踩到：本地 3.5.6 jar 与 Central 已发布 jar
             的 sha256 不同）。
             用法：mvn -Pcompat-file -Dcompat.oldJar=/path/to/spring-web-3.5.6.jar verify -->
        <profile>
            <id>compat-file</id>
            <activation>
                <property>
                    <name>compat.oldJar</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>japicmp</id>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <oldVersion>
                                        <file>
                                            <path>${compat.oldJar}</path>
                                        </file>
                                    </oldVersion>
                                    <newVersion>
                                        <file>
                                            <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                        </file>
                                    </newVersion>
                                    <!-- 缺失时 japicmp 默认 false：检出二进制不兼容也照样 BUILD SUCCESS，
                                         门禁形同虚设——只产出一份没人看的报告。这是它唯一能真正拦截的开关。 -->
                                    <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                    <parameter>
                                        <skipPomModules>true</skipPomModules>
                                        <onlyModified>true</onlyModified>
                                    </parameter>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Spring Boot 3.5.x（默认，无需显式激活；版本取顶层 spring-boot.version=3.5.16） -->
        <profile>
            <id>spring-boot-3.5</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- 使用默认值即可 -->
            </properties>
        </profile>

        <!-- Spring Boot 3.1.x -->
        <profile>
            <id>spring-boot-3.1</id>
            <properties>
                <spring-boot.version>3.1.12</spring-boot.version>
                <lombok.version>1.18.46</lombok.version>
                <junit-jupiter.version>5.9.3</junit-jupiter.version>
                <mockito.version>5.3.1</mockito.version>
                <byte-buddy.version>1.14.16</byte-buddy.version>
                <assertj.version>3.24.2</assertj.version>
                <snakeyaml.version>1.33</snakeyaml.version>
                <okhttp.version>4.10.0</okhttp.version>
                <maven-surefire-plugin.version>3.1.2</maven-surefire-plugin.version>
            </properties>
        </profile>

        <!-- Spring Boot 3.0.x -->
        <profile>
            <id>spring-boot-3.0</id>
            <properties>
                <spring-boot.version>3.0.13</spring-boot.version>
                <lombok.version>1.18.46</lombok.version>
                <junit-jupiter.version>5.9.3</junit-jupiter.version>
                <mockito.version>4.8.1</mockito.version>
                <byte-buddy.version>1.12.23</byte-buddy.version>
                <assertj.version>3.23.1</assertj.version>
                <netty.version>4.1.101.Final</netty.version>
                <snakeyaml.version>1.33</snakeyaml.version>
                <okhttp.version>4.10.0</okhttp.version>
                <jackson.version>2.15.4</jackson.version>
                <maven-surefire-plugin.version>3.1.2</maven-surefire-plugin.version>
            </properties>
        </profile>

        <!-- Spring Boot 3.3.x -->
        <profile>
            <id>spring-boot-3.3</id>
            <properties>
                <spring-boot.version>3.3.3</spring-boot.version>
            </properties>
        </profile>

        <!-- Spring Boot 3.4.x -->
        <profile>
            <id>spring-boot-3.4</id>
            <properties>
                <spring-boot.version>3.4.1</spring-boot.version>
            </properties>
        </profile>

        <!-- Spring Boot 3.2.x -->
        <profile>
            <id>spring-boot-3.2</id>
            <properties>
                <spring-boot.version>3.2.12</spring-boot.version>
            </properties>
        </profile>

        <!-- Spring Boot 4.x 的适配见 4.1.x 分支（master 仅维护 3.5.x） -->

        <profile>
            <id>spring-boot-2.7</id>
            <properties>
                <spring-boot.version>2.7.18</spring-boot.version>
            </properties>
        </profile>
        <profile>
            <id>spring-boot-2.6</id>
            <properties>
                <spring-boot.version>2.6.15</spring-boot.version>
            </properties>
        </profile>
        <profile>
            <id>spring-boot-2.5</id>
            <properties>
                <spring-boot.version>2.5.15</spring-boot.version>
            </properties>
        </profile>
        <profile>
            <id>spring-boot-2.4</id>
            <properties>
                <spring-boot.version>2.4.13</spring-boot.version>
            </properties>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <source>${java.version}</source>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <executable>${gpg.executable}</executable>
                            <keyname>${gpg.keyname}</keyname>
                            <passphrase>${gpg.passphrase}</passphrase>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.5.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>spring-web</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
