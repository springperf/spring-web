        <maven-deploy-plugin.version>3.1.2</maven-deploy-plugin.version>
        <maven-site-plugin.version>3.12.1</maven-site-plugin.version>
        <spotbugs-maven-plugin.version>4.10.4.1</spotbugs-maven-plugin.version>
        <!-- SpotBugs 报告阈值：默认拦 Default 档（高+中优先级）——全仓中优先级已从 416 清零
             （能改的真修、设计使然的逐条核对后写进 exclude 并注明依据），故门禁正式覆盖该档；
             需要临时放宽用 -Dspotbugs.threshold=High。
             写成属性引用而非字面量，否则 pom 值会压过命令行属性（实测：写死 High 时
             -Dspotbugs.threshold=Default 无效） -->
        <spotbugs.threshold>Default</spotbugs.threshold>
        <modernizer-maven-plugin.version>3.5.0</modernizer-maven-plugin.version>
        <japicmp-maven-plugin.version>0.26.2</japicmp-maven-plugin.version>
        <formatter-maven-plugin.version>2.29.0</formatter-maven-plugin.version>
        <rewrite-maven-plugin.version>6.46.1</rewrite-maven-plugin.version>
        <sortpom-maven-plugin.version>4.0.0</sortpom-maven-plugin.version>
