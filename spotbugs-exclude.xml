    <!-- SupportMultipartResolver：每连接复用的 multipart 解析器，start() 记下当前 HttpRequest、
         getRequest() 把同一个活引用交回（供超限时构造 413）。请求对象无法做防御性拷贝，且这两个
         方向都是设计契约，故排除。
         SupportMultipartResolver is a per-connection resolver: start() keeps the current
         HttpRequest and getRequest() hands the same live reference back (the 413 path needs
         it). An HttpRequest cannot be defensively copied, and both directions are the
         intended contract. -->
    <Match>
        <Class name="io.springperf.web.http.support.SupportMultipartResolver"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

