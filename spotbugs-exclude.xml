<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">

    <!-- org.springframework.** 下是本项目为源码级兼容而重写的 Spring API 镜像类（逐字带自
         上游实现，不由本项目维护）。它们的告警（如 NP_NULL_PARAM_DEREF_NONVIRTUAL）不在本项目
         可修范围内，故排除分析。
         Classes under org.springframework.** are source-compatible mirrors of the Spring API
         (carried over from upstream, not maintained here), so their findings are out of scope. -->
    <Match>
        <Package name="~org\.springframework\..*"/>
    </Match>

    <!-- io.springperf.webtest.** 是 E2E 的测试支撑代码（同 JaCoCo 的排除口径），非生产代码。
         io.springperf.webtest.** is E2E test scaffolding, not production code (same exclusion
         JaCoCo uses). -->
    <Match>
        <Package name="~io\.springperf\.webtest\..*"/>
    </Match>

    <!-- jmh_generated 是 JMH 注解处理器生成的基准桩代码（全仓 2745 条告警里它占 2375 条，
         其中 UUF_UNUSED_FIELD 2304 条），不手写、不评审，直接排除。
         jmh_generated holds JMH annotation-processor output: 2375 of 2745 findings repo-wide
         (2304 of them UUF_UNUSED_FIELD) come from generated benchmark stubs, which are neither
         hand-written nor reviewed. -->
    <Match>
        <Package name="~io\.springperf\.benchmark\..*jmh_generated.*"/>
    </Match>

    <!-- Spring CGLIB 生成的子类（$$SpringCGLIB$$N、$$FastClass$$N 等）同上：由 Spring 在代理
         配置类时生成，不是手写代码，也不受本项目评审（当前来源：examples 模块的配置类代理）。
         Spring CGLIB-generated subclasses, for the same reason: Spring emits them when proxying
         configuration classes, so they are neither hand-written nor reviewed here. -->
    <Match>
        <Class name="~.*\$\$SpringCGLIB\$\$.*"/>
    </Match>
    <Match>
        <Class name="~.*\$\$FastClass\$\$.*"/>
    </Match>

    <!-- 以下两处 EI_EXPOSE_REP 是「返回活引用」被测试锁定的契约，只读化会直接让测试失败
