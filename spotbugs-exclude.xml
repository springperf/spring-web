    <!-- 并发族（AT_NONATOMIC_64BIT_PRIMITIVE / AT_STALE_THREAD_WRITE_OF_PRIMITIVE /
         IS2_INCONSISTENT_SYNC）：这些字段是「配置快照」——在容器启动、开始接流量之前由单线程写入，
         此后只读。写入线程与读取线程之间由「启动读取线程」这一步建立 happens-before（JMM 第 17.4.5
         条的 Thread.start 规则），因此无需 volatile；而给热路径上的读加 volatile 反而会引入无谓屏障。
         唯一的例外是按并发语义本就必须 volatile 的（如 BaseWebServerHttpRequest.parameterMap），
         那些是改代码而不是豁免。逐类逐模式列出，不做整族泛化豁免。
         Concurrency family: configuration snapshots written once by the starting thread before any
         request is served, read-only afterwards. The write happens-before the reader threads by the
         Thread.start rule, so volatile would only tax the hot path. Anything that genuinely needs
         volatile is fixed rather than excluded. -->

    <Match>
        <Class name="io.springperf.web.autoconfigure.actuator.server.ManagementNettyHttpServer"/>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE"/>
    </Match>
    <Match>
        <Class name="io.springperf.web.server.NettyHttpServer"/>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE"/>
    </Match>
    <Match>
        <Class name="io.springperf.web.core.async.AsyncSupportRegistry"/>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE"/>
    </Match>
    <Match>
        <Class name="io.springperf.web.websocket.WebSocketHandlerRegistry"/>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE"/>
    </Match>
    <Match>
        <Class name="io.springperf.web.websocket.WebSocketHandlerRegistry"/>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
    <Match>
        <Class name="io.springperf.web.websocket.server.NettyWebSocketSession"/>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>
    <Match>
        <Class name="io.springperf.web.core.pool.BizPoolRegistry"/>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>

    <!-- PerfAsyncWebRequest.timeoutMillis：启动期按配置写入，之后只读（同上）。
         PerfAsyncWebRequest.concurrentResult：由工作线程写入，但读取发生在 state 的 CAS 之后
         （compareAndSet(ASYNC_STARTED, DISPATCHED) 成功才读），CAS 已建立 happens-before，
         故无需 volatile。 -->
    <Match>
        <Class name="io.springperf.web.core.async.PerfAsyncWebRequest"/>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE"/>
    </Match>
    <Match>
        <Class name="io.springperf.web.core.async.PerfAsyncWebRequest"/>
        <Bug pattern="IS2_INCONSISTENT_SYNC"/>
    </Match>

    <!-- ApplicationProperties.properties：Environment 引用仅在初始化时替换，其余读写走各自的
         缓存字段（stringCache 等已按 copy-on-write 发布）。 -->
    <Match>
        <Class name="io.springperf.web.context.ApplicationProperties"/>
        <Bug pattern="IS2_INCONSISTENT_SYNC"/>
    </Match>

    <!-- BaseWebServerHttpRequest.parameterMap：双检锁 + volatile（见字段注释），锁内写、锁外读
         是刻意设计；IS2 报"同步不一致"属预期，volatile 已保证发布语义。 -->
    <Match>
        <Class name="io.springperf.web.http.BaseWebServerHttpRequest"/>
        <Bug pattern="IS2_INCONSISTENT_SYNC"/>
    </Match>

    <!-- MS_EXPOSE_REP：PARSER/MATCHER 是进程级共享实例（Spring 的 PathPatternParser 与
         PathPatternUtils 自己的 RouteMatcher），按其契约线程安全且不可变式使用；返回新实例会
         破坏路径匹配的缓存与共享语义。 -->
    <Match>
        <Class name="io.springperf.web.util.PathPatternUtils"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- REC_CATCH_EXCEPTION：collectMemorySnapshot 是基准 setup 期的诊断采集，任何失败都只能
         告警后继续（写盘、ObjectMapper、目录创建等都可能抛不同异常），收窄会中断整个基准运行。 -->
    <Match>
        <Class name="io.springperf.benchmark.servlet.AbstractServerBenchmark"/>
