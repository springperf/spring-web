{
  "properties": [
    {
      "name": "spring.web.view.engine",
      "type": "java.lang.String",
      "defaultValue": "",
      "description": "Template engines (comma-separated): thymeleaf, freemarker, beetl. Empty -> register all available on classpath."
    },
    {
      "name": "spring.thymeleaf.prefix",
      "type": "java.lang.String",
      "defaultValue": "templates/",
      "description": "Thymeleaf template prefix (classpath-relative path)."
    },
    {
      "name": "spring.thymeleaf.suffix",
      "type": "java.lang.String",
      "defaultValue": ".html",
      "description": "Thymeleaf template suffix."
    },
    {
      "name": "spring.thymeleaf.cache",
      "type": "java.lang.Boolean",
      "defaultValue": true,
      "description": "Enable Thymeleaf template cache."
    },
    {
      "name": "spring.freemarker.prefix",
      "type": "java.lang.String",
      "defaultValue": "templates/",
      "description": "FreeMarker template prefix (classpath-relative path)."
    },
    {
      "name": "spring.freemarker.suffix",
      "type": "java.lang.String",
      "defaultValue": ".ftl",
      "description": "FreeMarker template suffix."
    },
    {
      "name": "spring.freemarker.cache",
      "type": "java.lang.Boolean",
      "defaultValue": true,
      "description": "Enable FreeMarker template cache."
    },
    {
      "name": "spring.beetl.prefix",
      "type": "java.lang.String",
      "defaultValue": "templates/",
      "description": "Beetl template prefix (classpath-relative path)."
    },
    {
      "name": "spring.beetl.suffix",
      "type": "java.lang.String",
      "defaultValue": ".btl",
      "description": "Beetl template suffix."
    },
    {
      "name": "spring.beetl.cache",
      "type": "java.lang.Boolean",
      "defaultValue": true,
      "description": "Enable Beetl template cache."
    },
    {
      "name": "spring.beetl.mode",
      "type": "java.lang.String",
      "defaultValue": "HTML",
      "description": "Beetl template mode (kept for symmetry with thymeleaf/freemarker)."
    },
    {
      "name": "spring.beetl.cache-ttl",
      "type": "java.time.Duration",
      "description": "Beetl template cache TTL (Duration style, e.g. 60s); takes effect only if the configured cache implementation supports TTL."
    },
    {
      "name": "spring.beetl.enabled",
      "type": "java.lang.Boolean",
      "defaultValue": true,
      "description": "Whether the Beetl view resolver is enabled. When false, resolveViewName returns null."
    },
    {
      "name": "spring.thymeleaf.encoding",
      "type": "java.lang.String",
      "defaultValue": "UTF-8",
      "description": "Character encoding for Thymeleaf template rendering. FreeMarker/Beetl default UTF-8 (no separate key, aligned with Boot)."
    }
  ]
}
