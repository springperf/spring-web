<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.springperf</groupId>
        <artifactId>spring-web-parent</artifactId>

        <version>4.1.7</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>spring-web-examples</artifactId>
    <packaging>pom</packaging>

    <name>perf-spring-web-examples</name>
    <description>Spring Perf Web 示例聚合模块，提供各场景的可运行示例应用</description>
    <url>https://github.com/springperf/spring-web</url>

    <modules>
        <!-- 测试支撑需先构建（examples 的 E2E 测试依赖它） -->
        <module>spring-web-example-support-test</module>
        <module>spring-web-example-rest</module>
        <module>spring-web-example-batch</module>
        <module>spring-web-example-realtime</module>
        <module>spring-web-example-upload</module>
        <module>spring-web-example-servlet-bridge</module>
        <module>spring-web-example-shiro</module>
        <module>spring-web-example-spring-security</module>
        <module>spring-web-example-data</module>
        <module>spring-web-example-async</module>
        <module>spring-web-example-actuator</module>
        <module>spring-web-example-openapi</module>
        <module>spring-web-example-swaggerui</module>
        <module>spring-web-example-ai</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
          Boot 4 把 TestRestTemplate / RestTemplateBuilder 从 spring-boot / spring-boot-test
          拆到独立 artifact 并改了包名（org.springframework.boot.resttestclient / restclient）。
          本分支（4.1.x）专用 Boot 4，故直接在主依赖声明
          （早期兼容写法是在 SB4 profile 下条件引入，以便同一份 pom 也能在 3.x 下编译）。
          各 example 测试统一 import io.springperf.example.support.TestRestTemplate
          （由 spring-web-example-support-test 提供的 shim），此处补的是其底层真实类。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
