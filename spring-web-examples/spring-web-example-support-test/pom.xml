<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.springperf</groupId>
        <artifactId>spring-web-parent</artifactId>

        <version>3.5.6</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>spring-web-example-support-test</artifactId>

    <name>perf-spring-web-example-support-test</name>
    <description>examples 的测试支撑：跨版本 TestRestTemplate 薄封装（按 Spring Boot profile 选择真实实现）</description>

    <properties>
        <!-- 不发布：仅供 examples 的 E2E 测试编译/运行 -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!-- 本模块无测试（只有 src/main 的 shim），跳过 surefire 以免其参与测试阶段报 no-tests -->
        <skipTests>true</skipTests>
    </properties>

    <dependencies>
        <!--
          编译期需要 TestRestTemplate / RestTemplateBuilder 的真实类。
          本分支（4.1.x）专用 Boot 4：这两个类在 Boot 4 移到了
          spring-boot-resttestclient / spring-boot-restclient
          （Boot 3 时代在 spring-boot-test 的 org.springframework.boot.test.web.client 下）。
          必须 optional：否则其传递依赖（含 spring-boot-test 自带的 junit/assertj 版本）会经
          test-scope 传递到下游 example，与下游自身的 starter-test 版本冲突，
          导致 surefire 报 "TestEngine with ID 'junit-jupiter' failed to discover tests"。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!-- spring-boot-test 的传递依赖在 provided scope 下不完整，需显式补 spring-web（含 ResponseExtractor 等）。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 挂载 sb4 源码根。早期兼容写法按 profile 在 sb3/sb4 间二选一，
                 专用化后只剩 sb4 一套实现，改为直接在主 build 声明。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-sb4-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/sb4/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
