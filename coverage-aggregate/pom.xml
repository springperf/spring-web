<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.springperf</groupId>
        <artifactId>spring-web-parent</artifactId>
        <!-- 必须是字面量：parent 的 version 在解析父子关系时需要先于属性插值可读，
             写 ${project.version} 会导致 Non-resolvable parent POM -->
        <version>4.1.7</version>
    </parent>

    <!--
        跨模块覆盖率聚合报告（无代码，仅聚合）。
        Reactor 排在最后：mvn test 结束时所有模块（含 E2E 模块）的 jacoco.exec 均已生成，
        此处用 report-aggregate 合并，产出 coverage-aggregate/target/site/jacoco-aggregate/。
    -->
    <artifactId>coverage-aggregate</artifactId>
    <packaging>pom</packaging>

    <dependencies>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web-servlet</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web-mvc-support</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web-websocket</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web-view</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web-batch</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web-test</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.springperf</groupId>
            <artifactId>spring-web-support-test</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <!-- 除 HTML 外再产出 CSV：scripts/coverage-report.{sh,ps1} 以该合并 CSV 为准
                                 （GROUP 列即模块），这样"E2E 触发的库模块覆盖"也计入报告，与聚合口径一致。
                                 Emit CSV next to the HTML so the coverage-report scripts can read the merged
                                 data (GROUP column = module) and include E2E-driven coverage. -->
                            <formats>HTML,CSV</formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
